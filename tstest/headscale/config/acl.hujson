{
  // Minimal policy for a same-user lab.
  // The real control plane is headscale; tailscaled enforces the SSH policy,
  // and this repo's patch moves the interception gate from port 22 to 2222.

  "groups": {
    "group:lab": ["lab@"],
  },

  "acls": [
    {
      "action": "accept",
      "src": ["group:lab"],
      "dst": ["group:lab:*"],
    },
  ],

  "ssh": [
    {
      "action": "accept",
      "src": ["group:lab"],
      "dst": ["autogroup:self"],
      "users": ["autogroup:nonroot"],
    },
  ],
}
